# Copy to .env and fill in. Only ANTHROPIC_API_KEY and TH_SIGNING_SEED matter
# for a real run; everything else has a working default.

DATABASE_URL=postgres://truehandshake:truehandshake@localhost:5433/truehandshake

# The AI witness. Without this the server falls back to the offline witness,
# which scans transcripts for numbers and cannot understand what was said —
# fine for walking the UI, useless as a witness.
ANTHROPIC_API_KEY=

# Ed25519 seed for the attestation chain, base64 of 32 bytes.
# Generate one with:  cargo run -p th-api -- --generate-seed
# Without it the server mints an ephemeral key and every receipt signed by that
# process stops verifying when it restarts.
TH_SIGNING_SEED=

TH_BIND=0.0.0.0:8080
TH_PUBLIC_BASE_URL=http://localhost:5173
TH_CURRENCY=USD

# Enables the mediator endpoint for resolving disputes. Leave empty to disable.
TH_MEDIATOR_TOKEN=

RUST_LOG=th_api=info,th_app=info,th_infra=info,th_jobs=info
